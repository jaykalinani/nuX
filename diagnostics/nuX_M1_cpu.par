# Small CPU-only run that exercises optional M1 diagnostic output.
# Numerical correctness is tested independently by nuX_Tests and thorn tests.

ActiveThorns = "
  ADMBaseX
  AsterMasks
  AsterX
  CarpetX
  Con2PrimFactory
  Cowling
  EOSX
  HydroBaseX
  IOUtil
  ODESolvers
  TmunuBaseX
  nuX_FakeRates
  nuX_M1
  nuX_Base
  nuX_M1_Seeds
  nuX_Utils
"

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"
Cactus::terminate = "iteration"
Cactus::cctk_itlast = 2

ADMBaseX::initial_data = "Cartesian Minkowski"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"
ADMBaseX::initial_dtlapse = "none"
ADMBaseX::initial_dtshift = "none"

AsterX::debug_mode = "no"
AsterX::freeze_evolution = yes
AsterX::flux_type = "LxF"
AsterX::local_estimate_error = "no"
AsterX::recon_type = "z_vec"

CarpetX::verbose = no
CarpetX::poison_undefined_values = no
CarpetX::poison_undefined_arrays = no
CarpetX::xmin = -2.0
CarpetX::ymin = -2.0
CarpetX::zmin = -4.0
CarpetX::xmax = 2.0
CarpetX::ymax = 2.0
CarpetX::zmax = 4.0
CarpetX::periodic = yes
CarpetX::periodic_x = yes
CarpetX::periodic_y = yes
CarpetX::periodic_z = yes
CarpetX::boundary_x = none
CarpetX::boundary_y = none
CarpetX::boundary_z = none
CarpetX::boundary_upper_x = none
CarpetX::boundary_upper_y = none
CarpetX::boundary_upper_z = none
CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 16
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 16
CarpetX::max_num_levels = 1
CarpetX::regrid_every = 100000
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::refine_grid_layout = no
CarpetX::restrict_during_sync = no
CarpetX::use_subcycling = no
CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 2
CarpetX::dtfac = 0.1

Con2PrimFactory::c2p_prime = "Noble"
Con2PrimFactory::c2p_second = "Palenzuela"
Con2PrimFactory::c2p_tol = 1e-8
Con2PrimFactory::max_iter = 100
Con2PrimFactory::rho_abs_min = 1e-8
Con2PrimFactory::unit_test = "no"
Con2PrimFactory::B_lim = 1e8
Con2PrimFactory::vw_lim = 1e8
Con2PrimFactory::Ye_lenient = "yes"

EOSX::evolution_eos = "IdealGas"
EOSX::gl_gamma = 2.0
EOSX::poly_gamma = 2.0
EOSX::rho_max = 1e8
EOSX::eps_max = 1e8

ODESolvers::method = "IMEX42L"
ReconX::reconstruction_method = "minmod"

nuX_FakeRates::eta_nue = 0.0
nuX_FakeRates::eta_nua = 0.0
nuX_FakeRates::eta_nux = 0.0
nuX_FakeRates::kappa_abs_nue = 0.0
nuX_FakeRates::kappa_abs_nua = 0.0
nuX_FakeRates::kappa_scat_nue = 1.0e3
nuX_FakeRates::kappa_scat_nua = 0.0
nuX_FakeRates::kappa_scat_nux = 0.0

nuX_M1::rates_lib = "FakeRates"
nuX_M1::add_to_Tmunu = "no"
nuX_M1::backreact = "no"
nuX_M1::bc_type = "none"
nuX_M1::closure = "Eddington"
nuX_M1::closure_epsilon = 1e-5
nuX_M1::closure_maxiter = 1000
nuX_M1::include_GR_sources = "no"
nuX_M1::include_fluxes = "yes"
nuX_M1::opacity_corr_fac_max = 1.0
nuX_M1::reset_to_equilibrium = "no"
nuX_M1::source_diagnostics = yes
nuX_M1::source_epsabs = 1e-15
nuX_M1::source_force_nonlinear = yes
nuX_M1::source_thick_limit = -1
nuX_M1::source_scat_limit = -1
nuX_M1::verbose = "no"

nuX_M1_Seeds::nuX_test_case = "diff_limit_gaussian"
nuX_M1_Seeds::initialize_asterx_vector_potential = yes
nuX_M1_Seeds::static_velz = 0.5
nuX_M1_Seeds::verbose = "no"

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_performance_every = 0
CarpetX::out_norm_every = 1
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes
CarpetX::out_norm_vars = "
  AsterX::cons_vector
  AsterX::rhs_vector
  HydroBaseX::rho
  HydroBaseX::temperature
  HydroBaseX::Ye
  HydroBaseX::vel
  nuX_Base::rN
  nuX_Base::rE
  nuX_Base::rF
  nuX_Base::rP
  nuX_M1::rnnu
  nuX_M1::rJ
  nuX_M1::rHt
  nuX_M1::rH
  nuX_M1::chi
  nuX_M1::opacs
  nuX_M1::nueave
  nuX_M1::fluidsources
  nuX_M1::fidu_vel
  nuX_M1::fidu_w_lorentz
  nuX_M1::source_update_delta_N
  nuX_M1::source_update_delta_E
  nuX_M1::source_update_delta_F
  nuX_M1::source_limiter_theta
  nuX_M1::source_solver_diagnostics
  nuX_M1::source_collision_delta
  nuX_M1::source_repair_delta
  nuX_M1::equilibrium_diagnostics
  nuX_M1::radiation_state_diagnostics
  nuX_M1::transport_diagnostics
"
