# Configuration FRAGMENT for an existing EOSX + nuX_M1 parameter file.
# Add nuX_WeakLib to ActiveThorns. The external WeakLibInterp wrapper belongs
# in the BUILD thornlist, not ActiveThorns. This is not a standalone evolution.
# Replace the table paths and use an EOSX EOS consistent with these opacities.

nuX_M1::rates_lib = "WeakLib"
nuX_M1::opacity_tau_trap = -1
nuX_M1::opacity_corr_fac_max = 1

nuX_WeakLib::emab_table = "/path/to/wl-Op-SFHo-15-25-50-E40-EmAb.h5"
nuX_WeakLib::iso_table = "/path/to/wl-Op-SFHo-15-25-50-E40-Iso.h5"
# Strict default: the file must label raw kernels explicitly as cm^-1 MeV^-2.
nuX_WeakLib::iso_table_convention = "explicit-kernel-units"
# For provenance-checked native FullWeakPhysics raw kernels labeled Per Centimeter,
# REPLACE the preceding declaration with this; filenames do not establish format:
# nuX_WeakLib::iso_table_convention = "weaklib-fullweakphysics-5836de98"
# This is a user convention declaration, not verified generator/EOS compatibility.
nuX_WeakLib::include_emab = yes
nuX_WeakLib::include_iso = yes
nuX_WeakLib::include_pair = no
nuX_WeakLib::include_nes = no
nuX_WeakLib::include_brem = no
nuX_WeakLib::include_plasmon = no
nuX_WeakLib::include_nuclei_ec = no
nuX_WeakLib::collision_model = "equilibrium"

# To use coupled actual-spectrum monopole collisions, REPLACE the equilibrium
# model above with monopole, set the desired channels to yes and provide their
# matching native tables. The sample paths alone do not establish EOS matching.
# nuX_WeakLib::collision_model = "monopole"
# nuX_WeakLib::pair_table = "/path/to/wl-Op-SFHo-15-25-50-E40-Pair.h5"
# nuX_WeakLib::nes_table = "/path/to/wl-Op-SFHo-15-25-50-E40-NES.h5"
# nuX_WeakLib::brem_table = "/path/to/wl-Op-SFHo-15-25-50-E40-Brem.h5"
# nuX_WeakLib::include_pair = yes
# nuX_WeakLib::include_nes = yes
# nuX_WeakLib::include_brem = yes
# nuX_WeakLib::include_plasmon = yes
# nuX_M1::source_limiter = -1

# Keep the direct mu_p+mu_e-mu_n combination if the relative nucleon mass
# difference is already retained; a COMMON nucleon reference shift cancels.
# Select rest-mass-subtracted only if each nucleon's OWN rest mass was removed.
# Negative individual potentials or the energy shift in eps do not decide this.
nuX_WeakLib::chemical_potentials = "total"
nuX_WeakLib::spectral_tail_tolerance = 1e-2
nuX_WeakLib::run_self_tests = yes
