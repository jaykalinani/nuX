SHARES: nuX_M1
EXTENDS KEYWORD rates_lib "Reaction-rate library used by nuX_M1"
{
  "WeakLib" :: "Use the optional WeakLibInterp tabulated grey provider"
}
USES BOOLEAN set_to_equilibrium
USES BOOLEAN reset_to_equilibrium
USES REAL equilibrium_rho_min
USES REAL rad_N_floor
USES REAL rad_E_floor
USES REAL rad_eps
USES REAL opacity_tau_trap
USES REAL opacity_corr_fac_max
USES REAL source_epsrel
USES INT source_maxiter
USES REAL closure_epsilon
USES INT closure_maxiter

SHARES: nuX_Base
USES INT nspecies
USES INT ngroups

SHARES: ODESolvers
USES KEYWORD method

RESTRICTED:

BOOLEAN include_emab "Use corrected charged-current absorption tables"
{
} "yes"

BOOLEAN include_iso "Use both Legendre moments of elastic scattering tables"
{
} "yes"

BOOLEAN include_pair "Include native electron/positron pair kernels in the coupled monopole source"
{
} "no"

BOOLEAN include_nes "Include native number-conserving electron/positron inelastic scattering"
{
} "no"

BOOLEAN include_brem "Include native HR98 nucleon-nucleon bremsstrahlung"
{
} "no"

BOOLEAN include_plasmon "Add only the analytic WeakRates plasmon channel with actual partner blocking and inverse balance"
{
} "no"

KEYWORD collision_model "Energy-spectrum approximation for grey WeakLib collision integrals"
{
  "equilibrium" :: "Retain the original matter-equilibrium EmAb/Iso averages"
  "monopole" :: "Coupled current-spectrum FD moments with native zeroth-order Pair/NES/Brem kernels"
} "equilibrium"

BOOLEAN include_nuclei_ec "Reserved: the optional EC_table nuclear capture subtable is not implemented"
{
} "no"

STRING emab_table "WeakLib EmAb HDF5 file (g/cm3, K, MeV, cm^-1 convention)"
{
  ".*" :: "File accessible to the AMReX I/O root"
} ""

STRING iso_table "WeakLib Iso HDF5 raw-kernel file; see iso_table_convention"
{
  ".*" :: "File accessible to the AMReX I/O root"
} ""

STRING pair_table "WeakLib electron/positron Pair kernel HDF5 file (cm^-1 MeV^-3)"
{
  ".*" :: "File accessible to the AMReX I/O root"
} ""

STRING nes_table "WeakLib electron/positron NES kernel HDF5 file (NPS=1, cm^-1 MeV^-3)"
{
  ".*" :: "File accessible to the AMReX I/O root"
} ""

STRING brem_table "WeakLib HR98 S_sigma HDF5 file (MeV^-1 response, not opacity)"
{
  ".*" :: "File accessible to the AMReX I/O root"
} ""

KEYWORD iso_table_convention "Host-only Iso raw-kernel convention/provenance declaration"
{
  "explicit-kernel-units" :: "Raw Legendre expansion coefficients labeled cm^-1 MeV^-2"
  "weaklib-fullweakphysics-5836de98" :: "User attests the pinned native FullWeakPhysics raw-kernel convention with legacy Per Centimeter label"
} "explicit-kernel-units"

KEYWORD chemical_potentials "EOSX nucleon chemical-potential rest-mass convention"
{
  "total" :: "Use mu_p+mu_e-mu_n directly; a common nucleon reference shift cancels"
  "rest-mass-subtracted" :: "Only if individual nucleon rest masses were removed; restore m_n-m_p in their difference"
} "total"

REAL spectral_tail_tolerance "Maximum conservative omitted FD number/energy tail relative to the tabulated-band integral"
{
  (0:1) :: "Require coverage of the full equilibrium spectrum without extrapolation"
} 1.0e-2

BOOLEAN run_self_tests "Run tiny host HDF fixtures plus synthetic provider tests on the active AMReX backend at table setup"
{
} "no"
