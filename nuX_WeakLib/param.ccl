SHARES: nuX_M1
EXTENDS KEYWORD rates_lib "Reaction-rate library used by nuX_M1"
{
  "WeakLib" :: "Use the optional WeakLibInterp tabulated grey provider"
}
USES BOOLEAN set_to_equilibrium
USES BOOLEAN reset_to_equilibrium
USES REAL equilibrium_rho_min
USES REAL rad_N_floor
USES REAL rad_E_floor
USES REAL rad_eps
USES REAL opacity_tau_trap
USES REAL opacity_corr_fac_max

SHARES: nuX_Base
USES INT nspecies
USES INT ngroups

SHARES: ODESolvers
USES KEYWORD method

RESTRICTED:

BOOLEAN include_emab "Use corrected charged-current absorption tables"
{
} "yes"

BOOLEAN include_iso "Use both Legendre moments of elastic scattering tables"
{
} "yes"

BOOLEAN include_pair "Reserved: coupled nonequilibrium grey pair closure is not implemented"
{
} "no"

BOOLEAN include_nes "Reserved: number-conserving grey NES redistribution is not implemented"
{
} "no"

BOOLEAN include_brem "Reserved: coupled nonequilibrium grey bremsstrahlung closure is not implemented"
{
} "no"

BOOLEAN include_nuclei_ec "Reserved: the optional EC_table nuclear capture subtable is not implemented"
{
} "no"

STRING emab_table "WeakLib EmAb HDF5 file (g/cm3, K, MeV, cm^-1 convention)"
{
  ".*" :: "File accessible to the AMReX I/O root"
} ""

STRING iso_table "WeakLib Iso HDF5 file (kernel units cm^-1 MeV^-2)"
{
  ".*" :: "File accessible to the AMReX I/O root"
} ""

KEYWORD chemical_potentials "EOSX nucleon chemical-potential rest-mass convention"
{
  "total" :: "Use mu_p+mu_e-mu_n directly; a common nucleon reference shift cancels"
  "rest-mass-subtracted" :: "Only if individual nucleon rest masses were removed; restore m_n-m_p in their difference"
} "total"

REAL spectral_tail_tolerance "Maximum conservative omitted FD number/energy tail relative to the tabulated-band integral"
{
  (0:1) :: "Require coverage of the full equilibrium spectrum without extrapolation"
} 1.0e-2

BOOLEAN run_self_tests "Run synthetic provider tests on the active AMReX backend at table setup"
{
} "no"
