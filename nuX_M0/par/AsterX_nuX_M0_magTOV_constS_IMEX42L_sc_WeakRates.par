# AsterX + nuX_M0 magnetized APRLDP TOV: WeakRates, IMEX42L, two-level subcycling

# -----------------------------------------------------------------------------
# Active thorns
# -----------------------------------------------------------------------------
ActiveThorns = "
ADMBaseX
AsterMasks
AsterSeeds
AsterX
BoxInBox
CarpetX
Con2PrimFactory
CoordinatesX
EOSX
HydroBaseX
ID_TabEOS_HydroQuantities
IOUtil
NRPyPlusTOVID
nuX_LeakageBase
nuX_M0
nuX_Utils
nuX_WeakRates
ODESolvers
ReconX
TmunuBaseX
Z4c
"

# -----------------------------------------------------------------------------
# Global variables
# -----------------------------------------------------------------------------
$itlast = 16
# Fast profiling grid: dx_base = 64/64 = 1.0 and dx_fine = 0.5.
$xmin = -32.0
$xmax = +32.0
$ncells = 64
$max_grid_size = 64
$nlevels = 2
$dtfac = 0.25

# =============================================================================
# Grid
# =============================================================================

# -----------------------------------------------------------------------------
# BoxInBox
# -----------------------------------------------------------------------------
BoxInBox::num_regions = 1

# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::position_x_1 = 0.0
BoxInBox::radius_1 = [-1.0, 16.0]

# -----------------------------------------------------------------------------
# CarpetX
# -----------------------------------------------------------------------------
CarpetX::xmin = $xmin
CarpetX::ymin = $xmin
CarpetX::zmin = $xmin

CarpetX::xmax = $xmax
CarpetX::ymax = $xmax
CarpetX::zmax = $xmax

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

CarpetX::max_tile_size_x = 1024000
CarpetX::max_tile_size_y = 1024000
CarpetX::max_tile_size_z = 1024000

CarpetX::blocking_factor_x = 8
CarpetX::blocking_factor_y = 8
CarpetX::blocking_factor_z = 8

CarpetX::max_grid_size_x = $max_grid_size
CarpetX::max_grid_size_y = $max_grid_size
CarpetX::max_grid_size_z = $max_grid_size

CarpetX::boundary_x = "neumann"
CarpetX::boundary_y = "neumann"
CarpetX::boundary_z = "neumann"
CarpetX::boundary_upper_x = "neumann"
CarpetX::boundary_upper_y = "neumann"
CarpetX::boundary_upper_z = "neumann"

CarpetX::ghost_size = 3

CarpetX::max_num_levels = $nlevels
CarpetX::regrid_every = 0

CarpetX::refine_grid_layout = no

CarpetX::prolongation_type = "poly-cons3lfb"
CarpetX::prolongation_order = 5
CarpetX::prolongate_per_group = yes
CarpetX::interpolation_order = 4

# =============================================================================
# Time integration
# =============================================================================

# -----------------------------------------------------------------------------
# Cactus
# -----------------------------------------------------------------------------
Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"
Cactus::terminate = "iteration"
Cactus::cctk_itlast = $itlast

# -----------------------------------------------------------------------------
# CarpetX
# -----------------------------------------------------------------------------
CarpetX::verbose = no
CarpetX::poison_undefined_values = yes
CarpetX::poison_undefined_arrays = yes
CarpetX::dtfac = $dtfac
CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

# -----------------------------------------------------------------------------
# ODESolvers
# -----------------------------------------------------------------------------
ODESolvers::verbose = no
ODESolvers::method = "IMEX42L"

# =============================================================================
# Initial data
# =============================================================================

# -----------------------------------------------------------------------------
# NRPyPlusTOVID
# -----------------------------------------------------------------------------
NRPyPlusTOVID::NRPyTOV_Cowling = "no"
NRPyPlusTOVID::TOV_filename = "/work/hdd/bgmi/jkalinan/TOV_ID/constS/APRLDP_TOV_s1/outputTOV_APRLDP_s1.txt"
NRPyPlusTOVID::rho_atmosphere = 1e-13
NRPyPlusTOVID::K_atmosphere = 1
NRPyPlusTOVID::Gamma_atmosphere = 1

# -----------------------------------------------------------------------------
# ADMBaseX
# -----------------------------------------------------------------------------
ADMBaseX::initial_data = "NRPyPlusTOVID"
ADMBaseX::initial_lapse = "NRPyPlusTOVID"
ADMBaseX::initial_shift = "NRPyPlusTOVID"
ADMBaseX::initial_dtlapse = "zero"
ADMBaseX::initial_dtshift = "zero"

# -----------------------------------------------------------------------------
# HydroBaseX
# -----------------------------------------------------------------------------
HydroBaseX::initial_hydro = "NRPyPlusTOVID"

# -----------------------------------------------------------------------------
# AsterSeeds
# -----------------------------------------------------------------------------
AsterSeeds::test_type = "3DTest"
AsterSeeds::test_case = "magTOV"
AsterSeeds::Afield_config = "internal dipole"
AsterSeeds::Ab = 68601.49940531788 # reference magnetic energy E_mag ~= 1.25e49
AsterSeeds::press_cut = 0.04
AsterSeeds::press_max = 0.000144915631222202
AsterSeeds::Avec_kappa = 2.0
AsterSeeds::dipole_x = [0.0]

# -----------------------------------------------------------------------------
# ID_TabEOS_HydroQuantities
# -----------------------------------------------------------------------------
ID_TabEOS_HydroQuantities::Y_e_filename = "/work/hdd/bgmi/jkalinan/TOV_ID/constS/APRLDP_TOV_s1/Ye_beq_APRLDP_s1.txt"
ID_TabEOS_HydroQuantities::id_temp_ent_type = "constant entropy"
ID_TabEOS_HydroQuantities::id_entropy = 1.0

# =============================================================================
# AsterX evolution
# =============================================================================

# -----------------------------------------------------------------------------
# AsterX
# -----------------------------------------------------------------------------
AsterX::debug_mode = "no"
AsterX::flux_type = "HLLE"
AsterX::use_uct = "yes"
AsterX::vector_potential_gauge = "generalized Lorenz"
AsterX::lorenz_damp_fac = 1.5/($dtfac*((2*$xmax)/$ncells))
AsterX::local_spatial_order = 4
AsterX::update_tmunu = "yes"
AsterX::tmunu_interp_order = 4
AsterX::local_estimate_error = "no"
AsterX::recon_type = "z_vec"
AsterX::use_entropy_fix = "no"
AsterX::use_pplim = "yes"
AsterX::use_deriv_shock_detector = "no"
AsterX::hydro_correction_order = 2
AsterX::mag_correction_order = 2
AsterX::prolongate_dbstag = "no"
AsterX::freeze_evolution = no

# -----------------------------------------------------------------------------
# Con2PrimFactory
# -----------------------------------------------------------------------------
Con2PrimFactory::unit_test = "no"
Con2PrimFactory::c2p_prime = "RePrimAnd"
Con2PrimFactory::c2p_second = "Palenzuela"
Con2PrimFactory::c2p_tol = 1e-8
Con2PrimFactory::max_iter = 1000
Con2PrimFactory::B_lim = 1e8
Con2PrimFactory::sigma_max = 1e4
Con2PrimFactory::inv_beta_max = 1e5
Con2PrimFactory::vw_lim = 10
Con2PrimFactory::Ye_lenient = "yes"
Con2PrimFactory::use_temperature = "yes"

# Atmosphere for tabulated EOS
Con2PrimFactory::thermal_eos_atmo = "yes"
Con2PrimFactory::rho_abs_min = 1e-13
Con2PrimFactory::atmo_tol = 1e-3
Con2PrimFactory::t_atmo = 9.9770006382257168e-03
Con2PrimFactory::Ye_atmo = 0.5
Con2PrimFactory::tauFluid_atmo = 1e-30

Con2PrimFactory::r_atmo = 500000
Con2PrimFactory::n_rho_atmo = 6
Con2PrimFactory::n_temp_atmo = 0.8759226975726387

Con2PrimFactory::alp_thresh = 0.1
Con2PrimFactory::rho_BH = 1e-1
Con2PrimFactory::eps_BH = 1.0
Con2PrimFactory::vwlim_BH = 0.4

# -----------------------------------------------------------------------------
# EOSX
# -----------------------------------------------------------------------------
EOSX::evolution_eos = "Tabulated3d"
EOSX::particle_mass = 930.18478708
EOSX::EOSTable_filename = "/work/hdd/bgmi/jkalinan/TOV_ID/constS/APRLDP_TOV_s1/APRLDP_3335_rho393_temp133_ye66_gitM180edd5_20190225_adj_mineps0.h5"
EOSX::rho_max = 1e8
EOSX::eps_max = 1e8
EOSX::eps_min = 1e-20

# -----------------------------------------------------------------------------
# ReconX
# -----------------------------------------------------------------------------
ReconX::reconstruct_with_temperature = "yes"
ReconX::reconstruction_method = "ppm"
#ReconX::loworder_method = "ppm"
ReconX::ppm_zone_flattening = "yes"
ReconX::ppm_shock_detection = "no"

# =============================================================================
# nuX evolution
# =============================================================================

# -----------------------------------------------------------------------------
# nuX_LeakageBase
# -----------------------------------------------------------------------------
nuX_LeakageBase::rates_lib = "WeakRates"
nuX_LeakageBase::neu_abs_type = "nuX_M0"
nuX_LeakageBase::init_method = "simple"
nuX_LeakageBase::atmo_rho = 1.0e-13
nuX_LeakageBase::density_cutoff = 1.0e-13
nuX_LeakageBase::DiffFact = 6.0
nuX_LeakageBase::store_free_rates = "yes"
nuX_LeakageBase::store_neu_luminosity = "yes"

# -----------------------------------------------------------------------------
# nuX_M0
# -----------------------------------------------------------------------------
nuX_M0::rmax = 32.0
nuX_M0::nrad = 128
nuX_M0::nray = 512
nuX_M0::compute_every = 1
nuX_M0::wait_until_time = -1.0
nuX_M0::bns_sep_threshold = -1.0
nuX_M0::use_reduced_opacity = "no"
nuX_M0::use_enedep_opacity = "no"
nuX_M0::excision = "no"
nuX_M0::verbose = "no"
nuX_M0::backreact = "yes"

# -----------------------------------------------------------------------------
# nuX_WeakRates
# -----------------------------------------------------------------------------
nuX_WeakRates::use_beta = "yes"
nuX_WeakRates::use_pair_procs = "no"
nuX_WeakRates::use_plasmon = "yes"
nuX_WeakRates::use_bremsstrahlung = "no"
nuX_WeakRates::use_elastic = "yes"

# =============================================================================
# Spacetime evolution
# =============================================================================

# -----------------------------------------------------------------------------
# Z4c
# -----------------------------------------------------------------------------
Z4c::calc_ADM_vars = yes
Z4c::calc_ADMRHS_vars = no
Z4c::calc_constraints = no
Z4c::chi_floor = 1.0e-6
Z4c::alphaG_floor = 1.0e-8
Z4c::epsdiss = 0.32
Z4c::veta_central = 1.0 / 1.7199
Z4c::boundary_conditions = "NewRadX"

# =============================================================================
# Validation output
# =============================================================================
CarpetX::out_metadata = no
CarpetX::out_performance_every = 8
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_every = 8
CarpetX::out_norm_vars = "
    ADMBaseX::lapse
    ADMBaseX::metric
    ADMBaseX::shift
    AsterX::cons_vector
    AsterX::diagnostics
    HydroBaseX::Bvec
    HydroBaseX::Ye
    HydroBaseX::eps
    HydroBaseX::press
    HydroBaseX::rho
    HydroBaseX::temperature
    HydroBaseX::vel
    nuX_LeakageBase::nuX_leakage_optd
    nuX_LeakageBase::nuX_leakage_opacity
    nuX_LeakageBase::nuX_leakage_abs_opacity
    nuX_LeakageBase::nuX_leakage_free_rates
    nuX_LeakageBase::nuX_leakage_eff_rates
    nuX_LeakageBase::nuX_leakage_abs
    nuX_LeakageBase::nuX_leakage_luminosity
"
IO::out_dir = $parfile
