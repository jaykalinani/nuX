# Parameter definitions for thorn nuX_Rates

BOOLEAN use_beta "include beta reactions"
{
} "yes"

BOOLEAN use_pair_procs "include pair processes"
{
} "yes"

BOOLEAN use_bremsstrahlung "include bremsstrahlung"
{
} "yes"

BOOLEAN use_inelastic "include inelastic scattering"
{
} "yes"

BOOLEAN use_elastic "include elastic/isoenergetic scattering"
{
} "yes"

BOOLEAN corr_dU "include dU correction"
{
} "no"

BOOLEAN corr_dmeff "include dmeff correction"
{
} "no"

BOOLEAN corr_WM_abs "include weak mag. absorption correction"
{
} "no"

BOOLEAN corr_WM_scat "include weak mag. scattering correction"
{
} "no"

BOOLEAN corr_decay "include nucleon decay correction"
{
} "no"

KEYWORD brem_implementation "NN bremsstrahlung implementation"
{
  "HR98"  :: "Hannestad-Raffelt 1998"
  "BRT06" :: "Burrows et al. 2006"
  "GP19"  :: "Guo-Martinez-Pinedo 2019"
} "HR98"

BOOLEAN corr_NN_medium "flag for inclusion of medium correction to HR98 NN brem kernel as in Fischer16"
{
} "no"

BOOLEAN neglect_blocking "neglect antineutrino blocking factor in pair processes"
{
} "no"

BOOLEAN beta_low_density_fallback "use the THC/WeakRates non-degenerate beta-process fallback at low density"
{
} "yes"

REAL beta_low_density_rho_threshold "Density threshold for the beta-process low-density fallback in g/cm^3"
{
    (0:* :: "Any positive density"
} 2.0e11
