# Schedule definitions for thorn nuX_M1_Seeds
#
# nuX_M1_Seeds - initial data provider for various tests with M1.

if (initialize_asterx_vector_potential) {
  SCHEDULE nuX_M1_Seeds_InitVectorPotential IN HydroBaseX_PostInitial {
    LANG: C
    WRITES: AsterX::Avec_x(everywhere)
    WRITES: AsterX::Avec_y(everywhere)
    WRITES: AsterX::Avec_z(everywhere)
  } "Initialize the magnetic vector potential for radiation transport tests"
}

if (CCTK_Equals(nuX_test_case, "beam")) {
  SCHEDULE nuX_M1_Seeds_SetupHydroTest_beam IN HydroBaseX_InitialData AFTER HydroBaseX_initial_data {
    LANG: C
    WRITES: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: HydroBaseX::Ye(everywhere)
  } "Setup beam test Hydro initial conditions."
}

if (CCTK_Equals(nuX_test_case, "kerrschild")) {
  SCHEDULE nuX_M1_Seeds_SetupHydroTest_kerrschild IN HydroBaseX_InitialData AFTER HydroBaseX_initial_data {
    LANG: C
    WRITES: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: HydroBaseX::Ye(everywhere)
  } "Setup KerrSchild test Hydro initial conditions."
}

if (CCTK_Equals(nuX_test_case, "adv_velocity_jump")) {
  SCHEDULE nuX_M1_Seeds_SetupHydroTest_adv_velocity_jump IN HydroBaseX_InitialData AFTER HydroBaseX_initial_data {
    LANG: C
    WRITES: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: HydroBaseX::Ye(everywhere)
  } "Setup advective step Hydro initial conditions."
}

if ((CCTK_Equals(nuX_test_case, "diff_limit_square")) || (CCTK_EQUALS(nuX_test_case, "diff_limit_gaussian"))) {
  SCHEDULE nuX_M1_Seeds_SetupHydroTest_diff_limit_test IN HydroBaseX_InitialData AFTER HydroBaseX_initial_data {
    LANG: C
    WRITES: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: HydroBaseX::Ye(everywhere)
  } "Setup diffusion limit test Hydro initial conditions."
}

if (CCTK_Equals(nuX_test_case, "shadow")) {
  SCHEDULE nuX_M1_Seeds_SetupHydroTest_shadow IN HydroBaseX_InitialData AFTER HydroBaseX_initial_data {
    LANG: C
    WRITES: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: HydroBaseX::Ye(everywhere)
  } "Setup shadow test Hydro initial conditions."
}

if (CCTK_Equals(nuX_test_case, "atmosphere")) {
  SCHEDULE nuX_M1_Seeds_SetupHydroTest_atmosphere IN HydroBaseX_InitialData AFTER HydroBaseX_initial_data {
    LANG: C
    WRITES: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: HydroBaseX::Ye(everywhere)
  } "Setup atmosphere test Hydro initial conditions."
}

if (CCTK_Equals(nuX_test_case, "sphere")) {
  SCHEDULE nuX_M1_Seeds_SetupHydroTest_sphere IN HydroBaseX_InitialData AFTER HydroBaseX_initial_data {
    LANG: C
    WRITES: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: HydroBaseX::Ye(everywhere)
  } "Setup sphere test Hydro initial conditions."
}

if (CCTK_Equals(nuX_test_case, "beam")) {
  SCHEDULE nuX_M1_Seeds_SetupNeutTest_beam IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Setup beam test Neutrino initial conditions."
}

if (CCTK_Equals(nuX_test_case, "equil")) {
  SCHEDULE nuX_M1_Seeds_SetupNeutTest_equil IN nuX_M1_InitialData {
    LANG: C
    READS: ADMBaseX::metric(everywhere)
    READS: HydroBaseX::vel(everywhere)
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Setup thermal equilibrium test Neutrino initial conditions."
}

if (CCTK_Equals(nuX_test_case, "kerrschild")) {
  SCHEDULE nuX_M1_Seeds_SetupNeutTest_kerrschild IN nuX_M1_InitialData {
    LANG: C
    READS: ADMBaseX::metric(everywhere) ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere)
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Setup KerrSchild test Neutrino initial conditions."

  SCHEDULE nuX_M1_Seeds_KerrInflow IN nuX_M1_BoundaryConditions AFTER nuX_M1_ApplyBCs {
    LANG: C
    READS: ADMBaseX::metric(everywhere) ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere)
    READS: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Apply Kerr inflow boundary injection (shadow-style)."

  SCHEDULE nuX_M1_Seeds_KerrSchild_Mask IN nuX_M1_RHSGroup \
      AFTER nuX_M1_SetMask BEFORE nuX_M1_SyncConserved {
    LANG: C
    READS: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
    WRITES: nuX_M1::nuX_m1_mask(everywhere)
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Apply KerrSchild excision mask before each ODESolvers RHS evaluation."
}

if (CCTK_Equals(nuX_test_case, "adv_velocity_jump")) {
  SCHEDULE nuX_M1_Seeds_SetupNeutTest_adv_velocity_jump IN nuX_M1_InitialData {
    LANG: C
    READS: ADMBaseX::metric(everywhere)
    READS: HydroBaseX::vel(everywhere)
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Setup advective step test Neutrino initial conditions."
}

if ((CCTK_Equals(nuX_test_case, "diff_limit_square")) || (CCTK_EQUALS(nuX_test_case, "diff_limit_gaussian"))) {
  SCHEDULE nuX_M1_Seeds_SetupNeutTest_diff_limit_test IN nuX_M1_InitialData {
    LANG: C
    READS: ADMBaseX::metric(everywhere)
    READS: HydroBaseX::vel(everywhere)
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Setup diffusion limit test Neutrino initial conditions."
}

if (CCTK_Equals(nuX_test_case, "shadow")) {
  SCHEDULE nuX_M1_Seeds_SetupNeutTest_shadow IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Setup shadow test Neutrino initial conditions."

  SCHEDULE nuX_M1_Seeds_ShadowBCs IN nuX_M1_BoundaryConditions AFTER nuX_M1_ApplyBCs {
    LANG: C
    READS: nuX_Base::rN(interior) nuX_Base::rE(interior) nuX_Base::rF(interior)
    WRITES: nuX_Base::rN(interiorwithboundary) nuX_Base::rE(interiorwithboundary) nuX_Base::rF(interiorwithboundary)
  } "Apply shadow test inflow boundary conditions."

}

if (CCTK_Equals(nuX_test_case, "atmosphere")) {
  SCHEDULE nuX_M1_Seeds_SetupNeutTest_atmosphere IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Setup atmosphere test Neutrino initial conditions."
}

if (CCTK_Equals(nuX_test_case, "sphere")) {
  SCHEDULE nuX_M1_Seeds_SetupNeutTest_sphere IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere) nuX_Base::rF(everywhere)
  } "Setup sphere test Neutrino initial conditions."
}

# Reuse the existing uniform-hydro and vacuum-radiation initializers.
if (CCTK_Equals(nuX_test_case, "crossing_beams") ||
    CCTK_Equals(nuX_test_case, "expanding_absorber")) {
  SCHEDULE nuX_M1_Seeds_SetupHydroTest_beam IN HydroBaseX_InitialData \
      AFTER HydroBaseX_initial_data {
    LANG: C
    WRITES: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere)
    WRITES: HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: HydroBaseX::Ye(everywhere)
  } "Initialize uniform static matter for the radiation tests"

  SCHEDULE nuX_M1_Seeds_SetupNeutTest_shadow IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_Base::rN(everywhere) nuX_Base::rE(everywhere)
    WRITES: nuX_Base::rF(everywhere)
  } "Initialize vacuum radiation for the radiation tests"
}

if (CCTK_Equals(nuX_test_case, "expanding_absorber")) {
  # Replace density-scaled FakeRates with the prescribed emitter/absorber rates
  # before each explicit or implicit evaluation, using existing rate storage.
  SCHEDULE nuX_M1_Seeds_ExpandingAbsorberRates IN nuX_M1_InitialGroup \
      AFTER nuX_M1_CalcClosure {
    LANG: C
    WRITES: nuX_M1::opacs(everywhere) nuX_M1::nueave(everywhere)
  } "Set prescribed benchmark rates on initial AMR levels"

  SCHEDULE nuX_M1_Seeds_ExpandingAbsorberRates IN nuX_M1_RHSGroup \
      AFTER nuX_M1_CalcOpacityFakeRates \
      BEFORE (nuX_M1_SyncDerived nuX_M1_CalcFluxes \
              nuX_M1_UpdateRHSFromFluxes nuX_M1_CalcBackreactionRHS) {
    LANG: C
    WRITES: nuX_M1::opacs(everywhere) nuX_M1::nueave(everywhere)
  } "Set prescribed rates before the explicit radiation fluxes"

  SCHEDULE nuX_M1_Seeds_ExpandingAbsorberRates IN nuX_M1_ImplicitRHSGroup \
      AFTER nuX_M1_CalcOpacityFakeRates \
      BEFORE (nuX_M1_CalcSourceRHS nuX_M1_CalcBackreactionRHS) {
    LANG: C
    WRITES: nuX_M1::opacs(everywhere) nuX_M1::nueave(everywhere)
  } "Set prescribed rates before evaluating the IMEX collision RHS"

  if (!CCTK_Equals(method, "semi-implicit")) {
    SCHEDULE nuX_M1_Seeds_ExpandingAbsorberRates IN nuX_M1_SourceGroup \
        AFTER nuX_M1_CalcOpacityFakeRates BEFORE nuX_M1_CalcUpdate {
      LANG: C
      WRITES: nuX_M1::opacs(everywhere) nuX_M1::nueave(everywhere)
    } "Set prescribed rates before the diagonal implicit solve"
  }

  SCHEDULE nuX_M1_Seeds_ExpandingAbsorberRates IN nuX_M1_PostStepDerived \
      AFTER nuX_M1_CalcOpacityFakeRates {
    LANG: C
    WRITES: nuX_M1::opacs(everywhere) nuX_M1::nueave(everywhere)
  } "Keep output rates equal to the prescribed benchmark profiles"
}

if (CCTK_Equals(nuX_test_case, "crossing_beams")) {
  SCHEDULE nuX_M1_Seeds_CrossingBeamBCs IN nuX_M1_InitialData \
      AFTER nuX_M1_Seeds_SetupNeutTest_shadow {
    LANG: C
    READS: nuX_Base::rN(interiorwithboundary) nuX_Base::rE(interiorwithboundary)
    READS: nuX_Base::rF(interiorwithboundary)
    WRITES: nuX_Base::rN(interiorwithboundary) nuX_Base::rE(interiorwithboundary)
    WRITES: nuX_Base::rF(interiorwithboundary)
  } "Initialize the two beam inflow boundaries"

  SCHEDULE nuX_M1_Seeds_CrossingBeamBCs IN nuX_M1_BoundaryConditions \
      AFTER nuX_M1_ApplyBCs {
    LANG: C
    READS: nuX_Base::rN(interiorwithboundary) nuX_Base::rE(interiorwithboundary)
    READS: nuX_Base::rF(interiorwithboundary)
    WRITES: nuX_Base::rN(interiorwithboundary) nuX_Base::rE(interiorwithboundary)
    WRITES: nuX_Base::rF(interiorwithboundary)
  } "Inject both beams in the lower-x interior layer and physical ghost zones"
}
