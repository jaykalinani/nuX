# Small periodic HLLE smoke case; no reference output is supplied yet.
# Transparent oblique moving radiation by default. For the advected diffusion
# case, change kappa_scat_nue to 1e3 and closure to "Eddington".
ActiveThorns = "
  ADMBaseX AsterMasks AsterX CarpetX Con2PrimFactory EOSX HydroBaseX
  IOUtil ODESolvers TmunuBaseX nuX_Base nuX_FakeRates nuX_M1 nuX_M1_Seeds nuX_Utils
"

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 8
Cactus::presync_mode = "mixed-error"
Cactus::cctk_show_schedule = no

ADMBaseX::initial_data = "Cartesian Minkowski"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"
ADMBaseX::initial_dtlapse = "none"
ADMBaseX::initial_dtshift = "none"

AsterX::debug_mode = yes
AsterX::freeze_evolution = yes
AsterX::flux_type = "LxF"
AsterX::local_estimate_error = no
AsterX::recon_type = "z_vec"

CarpetX::xmin = -4
CarpetX::ymin = -4
CarpetX::zmin = -4
CarpetX::xmax = 4
CarpetX::ymax = 4
CarpetX::zmax = 4
CarpetX::ncells_x = 4
CarpetX::ncells_y = 4
CarpetX::ncells_z = 64
CarpetX::max_num_levels = 1
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::ghost_size = 2
CarpetX::dtfac = 0.1
CarpetX::periodic = yes
CarpetX::periodic_x = yes
CarpetX::periodic_y = yes
CarpetX::periodic_z = yes
CarpetX::boundary_x = none
CarpetX::boundary_y = none
CarpetX::boundary_z = none
CarpetX::boundary_upper_x = none
CarpetX::boundary_upper_y = none
CarpetX::boundary_upper_z = none
CarpetX::prolongation_type = "ddf"
CarpetX::poison_undefined_values = yes
CarpetX::poison_undefined_arrays = yes
CarpetX::out_metadata = no
CarpetX::out_norm_every = 1
CarpetX::out_norm_vars = "nuX_Base::rN nuX_Base::rE nuX_Base::rF"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_tsv_vars = "nuX_Base::rN nuX_Base::rE nuX_Base::rF"

Con2PrimFactory::c2p_prime = "Noble"
Con2PrimFactory::c2p_second = "Palenzuela"
Con2PrimFactory::c2p_tol = 1e-8
Con2PrimFactory::max_iter = 100
Con2PrimFactory::rho_abs_min = 1e-8
Con2PrimFactory::unit_test = yes
Con2PrimFactory::B_lim = 1e8
Con2PrimFactory::vw_lim = 1e8
Con2PrimFactory::Ye_lenient = yes

EOSX::evolution_eos = "IdealGas"
EOSX::gl_gamma = 2
EOSX::poly_gamma = 2
EOSX::rho_max = 1e8
EOSX::eps_max = 1e8
ODESolvers::method = "IMEX42L"

nuX_FakeRates::eta_nue = 0
nuX_FakeRates::eta_nua = 0
nuX_FakeRates::eta_nux = 0
nuX_FakeRates::kappa_abs_nue = 0
nuX_FakeRates::kappa_abs_nua = 0
nuX_FakeRates::kappa_abs_nux = 0
nuX_FakeRates::kappa_scat_nue = 0
nuX_FakeRates::kappa_scat_nua = 0
nuX_FakeRates::kappa_scat_nux = 0

nuX_M1::transport_flux = "hlle"
nuX_M1::hlle_limiter = "mc"
nuX_M1::rates_lib = "FakeRates"
nuX_M1::closure = "Minerbo"
nuX_M1::add_to_Tmunu = no
nuX_M1::backreact = no
nuX_M1::bc_type = "none"
nuX_M1::include_GR_sources = no
nuX_M1::include_fluxes = yes
nuX_M1::store_radial_fluxes = no
nuX_M1::reset_to_equilibrium = no
nuX_M1::source_limiter = -1
nuX_M1::source_epsabs = 1e-15

nuX_M1_Seeds::nuX_test_case = "diff_limit_gaussian"
nuX_M1_Seeds::initialize_asterx_vector_potential = yes
nuX_M1_Seeds::static_velx = 0.1
nuX_M1_Seeds::static_vely = -0.1
nuX_M1_Seeds::static_velz = 0.5

IO::out_dir = $parfile
IO::out_every = 8
IO::parfile_write = no
