# Source-only IMEX policy regression; intentionally unexecuted reference input.
# At rho=alpha=Gamma=1: nue decays at 100, nua at 1, nux is transparent.
# N and E must agree, and nux must be unchanged. Compare the whole-step scalar
# RK stability function for the selected method, not a backward-Euler step.
# Set legacy thresholds to -1, or source_force_nonlinear=yes: identical IMEX.
ActiveThorns = "
  ADMBaseX AsterMasks AsterX CarpetX Con2PrimFactory Cowling EOSX HydroBaseX
  IOUtil ODESolvers ReconX TimerReport TmunuBaseX
  nuX_Base nuX_FakeRates nuX_M1 nuX_M1_Seeds nuX_Utils
"

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 4
Cactus::presync_mode = "mixed-error"
ADMBaseX::initial_data = "Cartesian Minkowski"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"
ADMBaseX::initial_dtlapse = "none"
ADMBaseX::initial_dtshift = "none"

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = 1.0
CarpetX::ymax = 1.0
CarpetX::zmax = 1.0
CarpetX::ncells_x = 4
CarpetX::ncells_y = 4
CarpetX::ncells_z = 16
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::max_num_levels = 1
CarpetX::ghost_size = 2
CarpetX::dtfac = 0.1
CarpetX::periodic = yes
CarpetX::periodic_x = yes
CarpetX::periodic_y = yes
CarpetX::periodic_z = yes
CarpetX::boundary_x = "none"
CarpetX::boundary_y = "none"
CarpetX::boundary_z = "none"
CarpetX::boundary_upper_x = "none"
CarpetX::boundary_upper_y = "none"
CarpetX::boundary_upper_z = "none"
CarpetX::poison_undefined_values = yes
CarpetX::poison_undefined_arrays = yes

AsterX::freeze_evolution = yes
AsterX::update_tmunu = no
AsterX::local_estimate_error = no
AsterX::flux_type = "LxF"
Con2PrimFactory::c2p_prime = "Noble"
Con2PrimFactory::c2p_second = "Palenzuela"
Con2PrimFactory::rho_abs_min = 1e-8
Con2PrimFactory::unit_test = no
EOSX::evolution_eos = "IdealGas"
EOSX::gl_gamma = 2.0
EOSX::poly_gamma = 2.0
EOSX::rho_max = 1e8
EOSX::eps_max = 1e8
ReconX::reconstruction_method = "minmod"
ODESolvers::method = "IMEX42L"

nuX_M1::rates_lib = "FakeRates"
nuX_M1::backreact = no
nuX_M1::add_to_Tmunu = no
nuX_M1::include_fluxes = no
nuX_M1::include_GR_sources = no
nuX_M1::fiducial_velocity = "lab"
nuX_M1::closure = "Minerbo"
nuX_M1::closure_epsilon = 1e-12
nuX_M1::use_fallback = no
nuX_M1::rad_E_floor = 1e-30
nuX_M1::rad_N_floor = 1e-30
nuX_M1::opacity_corr_fac_max = 1.0
nuX_M1::opacity_tau_trap = -1.0
nuX_M1::source_limiter = -1.0
nuX_M1::source_force_nonlinear = no
nuX_M1::source_thick_limit = 0.01
nuX_M1::source_scat_limit = 0.01
nuX_M1::source_therm_limit = 0.01
nuX_M1::source_epsabs = 1e-30
nuX_M1::source_epsrel = 1e-10

nuX_FakeRates::eta_nue = 0.0
nuX_FakeRates::eta_nua = 0.0
nuX_FakeRates::eta_nux = 0.0
nuX_FakeRates::eta_anux = 0.0
nuX_FakeRates::kappa_abs_nue = 100.0
nuX_FakeRates::kappa_abs_nua = 1.0
nuX_FakeRates::kappa_abs_nux = 0.0
nuX_FakeRates::kappa_abs_anux = 0.0
nuX_FakeRates::kappa_scat_nue = 0.0
nuX_FakeRates::kappa_scat_nua = 0.0
nuX_FakeRates::kappa_scat_nux = 0.0
nuX_FakeRates::kappa_scat_anux = 0.0

nuX_M1_Seeds::nuX_test_case = "diff_limit_gaussian"
nuX_M1_Seeds::static_rho = 1.0
nuX_M1_Seeds::initialize_asterx_vector_potential = yes

IO::out_dir = $parfile
IO::out_every = 1
CarpetX::out_tsv_vars = "nuX_Base::rN nuX_Base::rE nuX_Base::rF"
