# Interface definition for thorn nuX_M1
IMPLEMENTS: nuX_M1
INHERITS: ADMBaseX AsterX CarpetXRegrid HydroBaseX TmunuBaseX nuX_Base

INCLUDES HEADER: nuX_M1_closure.hxx IN nuX_M1_closure.hxx 

USES INCLUDE HEADER: aster_fd.hxx aster_interp.hxx aster_utils.hxx
USES INCLUDE HEADER: nuX_baryon_mass.hxx nuX_metric.hxx nuX_pow.hxx nuX_rate_units.hxx nuX_tensor.hxx nuX_valencia.hxx nuX_utils.hxx
USES INCLUDE HEADER: m1_opacities.hpp
USES INCLUDE HEADER: nuX_fakerates.hxx
USES INCLUDE HEADER: nuX_weakrates.hxx

# === External functions ===

# Carpet
CCTK_INT FUNCTION EnableProlongating(CCTK_INT IN status)
USES FUNCTION EnableProlongating

CCTK_INT FUNCTION QueryProlongating()
USES FUNCTION QueryProlongating

CCTK_REAL FUNCTION ODESolvers_GetStepDeltaTime()
USES FUNCTION ODESolvers_GetStepDeltaTime

CCTK_INT FUNCTION ODESolvers_InPreImplicitStage()
USES FUNCTION ODESolvers_InPreImplicitStage


# === Public grid functions ===

PUBLIC:

##TODO: add correct dependents and tags for checkpointing

## ODESolvers owns old-state and RK/IMEX stage storage, so evolution routines
## should use only the current state pointers passed to the active schedule bin.

## Fluid frame quantities
CCTK_REAL rnnu[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Neutrino density in the fluid frame"

CCTK_REAL rJ[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Radiation energy density in the fluid frame"

CCTK_REAL rHt[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Radiation energy flux in the fluid frame"

CCTK_REAL rH[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"'
{
    rHx, rHy, rHz
} "Radiation energy flux in the fluid frame"

CCTK_REAL nuX_m1_mask TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Mask points that should not be evolved"

# === Private grid functions ===

PRIVATE:

## neutrino fluxes in x–direction
CCTK_REAL nu_flux_x[nuX_Base::nspecies*nuX_Base::ngroups*5] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Neutrino flux components in the x–direction: 5 fields per (species,group)"

# neutrino fluxes in y–direction
CCTK_REAL nu_flux_y[nuX_Base::nspecies*nuX_Base::ngroups*5] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Neutrino flux components in the y–direction: 5 fields per (species,group)"

# neutrino fluxes in z–direction
CCTK_REAL nu_flux_z[nuX_Base::nspecies*nuX_Base::ngroups*5] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Neutrino flux components in the z–direction: 5 fields per (species,group)"

## Diagnostics
CCTK_REAL radial_fluxes[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"'
{
    radial_flux_0, radial_flux_1
} "Neutrino radial number and energy fluxes"

## Radiation-matter interaction
CCTK_REAL opacs[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"'
{
    abs_0, abs_1, eta_0, eta_1, scat_1
} "Opacity variables"

CCTK_REAL nueave[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Neutrino average energy (in equilibrium or in the energy group)"

CCTK_REAL fluidsources TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"'
{
    netabs, netheat
} "Net number and energy absorption (for analysis only)"

CCTK_REAL neutrino_fractions TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' 
{
    ynue, ynua, ynux,
    znue, znua, znux
} "Neutrino fractions (for analysis only)"

## Internal variables
CCTK_REAL fidu_vel TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"'
{
    fidu_velx, fidu_vely, fidu_velz
} "Effective velocity v^i"

CCTK_REAL fidu_w_lorentz TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Effective Lorentz factor W"

CCTK_REAL chi[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "M1 closure coefficient"

CCTK_REAL rN_rhs[nuX_Base::nspecies*nuX_Base::ngroups] TIMELEVELS=4 TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "RHS for the radiation number density"

CCTK_REAL rE_rhs[nuX_Base::nspecies*nuX_Base::ngroups] TIMELEVELS=4 TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "RHS for the radiation energy density"

##TODO: check for centering
CCTK_REAL rF_rhs[nuX_Base::nspecies*nuX_Base::ngroups] TIMELEVELS=4 TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"'
{
    rFx_rhs, rFy_rhs, rFz_rhs
} "RHS for the radiation energy fluxes"

CCTK_REAL source_update_delta_N[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Stage-local radiation number source increment"

CCTK_REAL source_update_delta_E[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Stage-local radiation energy source increment"

CCTK_REAL source_update_delta_F[nuX_Base::nspecies*nuX_Base::ngroups] TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"'
{
    source_update_delta_Fx, source_update_delta_Fy, source_update_delta_Fz
} "Stage-local radiation flux source increment"

CCTK_REAL source_limiter_theta TYPE=GF CENTERING={ccc} TAGS='checkpoint="no"' "Limiter applied to the radiation-matter source update"
