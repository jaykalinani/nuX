# Parameter definitions for thorn nuX_WeakRates

RESTRICTED:

BOOLEAN use_beta "Include electron and positron capture"
{
} "yes"

BOOLEAN use_pair_procs "Include electron-positron pair annihilation"
{
} "yes"

BOOLEAN use_plasmon "Include plasmon decay"
{
} "yes"

BOOLEAN use_nonbeta_detailed_balance "Add inverse pair, plasmon, and enabled bremsstrahlung rates through detailed balance"
{
} "no"

BOOLEAN use_bremsstrahlung "Include nucleon-nucleon bremsstrahlung"
{
} "no"

BOOLEAN use_elastic "Include elastic scattering on nucleons and nuclei"
{
} "yes"

REAL beta_low_density_rho_threshold "Density below which the non-degenerate beta-process limit is used in g/cm^3"
{
    (0:* :: "Any positive density"
} 2.0e11
